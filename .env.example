# ===========================================
# Podium Personnel Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing real secrets
#
# Keys prefixed with NEXT_PUBLIC_ are exposed to the browser
# All other keys are server-side only (keep these SECRET)
# ===========================================

# -----------------
# Supabase (Required)
# -----------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# PUBLIC: Safe for browser - used for client-side auth & queries
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SECRET: Server-side only - bypasses Row Level Security
# Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------
# App Configuration
# -----------------
# The base URL of your application (no trailing slash)
# Used for generating email links and redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------
# Google Maps (Optional)
# -----------------
# For venue address autocomplete
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------
# Email - Resend (Required for emails)
# -----------------
# Get from: https://resend.com/api-keys
# SECRET: Server-side only - do not expose!
RESEND_API_KEY=your_resend_api_key

# The "From" address for outgoing emails
# Format: "Name <email@domain.com>"
# Must use a verified domain in Resend
EMAIL_FROM=Podium <noreply@yourdomain.com>

# --- EMAIL SAFE MODE (testing protection) ---
# When ON, ONLY addresses in EMAIL_ALLOWLIST receive email; every other
# recipient (including real musicians) is suppressed and logged as
# "[EMAIL SUPPRESSED]". This is the kill switch that lets you test against
# live accounts without emailing real musicians.
#
# FAIL-SAFE: safe mode is ON by default whenever EMAIL_SAFE_MODE is unset.
# To send real email in production you MUST explicitly set EMAIL_SAFE_MODE=false.
EMAIL_SAFE_MODE=true

# Comma-separated list of addresses allowed to receive mail while safe mode is on.
# Seed this with your own team's test inboxes.
EMAIL_ALLOWLIST=henrydavidphotography@gmail.com

# -----------------
# Stripe (Required for billing)
# -----------------
# Get from: https://dashboard.stripe.com/apikeys
# SECRET: Server-side only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# The Stripe Price ID for your Pro plan
# Get from: https://dashboard.stripe.com/products
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# -----------------
# Cron Jobs (Required for scheduled tasks)
# -----------------
# A secret string to authenticate Vercel cron job requests
# Generate a strong random string for production
CRON_SECRET=your_cron_secret

# Defense-in-depth switch for scheduled jobs. Defaults ENABLED when unset.
# Set CRON_ENABLED=false in a testing/preview environment to make all cron
# jobs no-op (they log and skip) so they don't auto-send or mutate state.
CRON_ENABLED=true
