# ===========================================
# Podium Personnel Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing real secrets
#
# Keys prefixed with NEXT_PUBLIC_ are exposed to the browser
# All other keys are server-side only (keep these SECRET)
# ===========================================

# -----------------
# Supabase (Required)
# -----------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# PUBLIC: Safe for browser - used for client-side auth & queries
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SECRET: Server-side only - bypasses Row Level Security
# Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------
# App Configuration
# -----------------
# The base URL of your application (no trailing slash)
# Used for generating email links and redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------
# Google Maps (Optional)
# -----------------
# For venue address autocomplete
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------
# Email - Resend (Required for emails)
# -----------------
# Get from: https://resend.com/api-keys
# SECRET: Server-side only - do not expose!
RESEND_API_KEY=your_resend_api_key

# The "From" identity for outgoing email, set as TWO separate vars. The code
# composes "Name <address>" itself — there is no EMAIL_FROM var to set, and an
# earlier version of this file wrongly said there was. Setting EMAIL_FROM has no
# effect: mail goes out from the default below, and if that domain is not
# verified in Resend, every send fails.
#
# The address's domain MUST be verified in Resend.
EMAIL_FROM_ADDRESS=hello@yourdomain.com
EMAIL_FROM_NAME=Podium

# Where replies go. Defaults to EMAIL_FROM_ADDRESS when unset.
EMAIL_REPLY_TO=hello@yourdomain.com

# --- EMAIL SAFE MODE (testing protection) ---
# When ON, ONLY addresses in EMAIL_ALLOWLIST receive email; every other
# recipient (including real musicians) is suppressed and logged as
# "[EMAIL SUPPRESSED]". This is the kill switch that lets you test against
# live accounts without emailing real musicians.
#
# FAIL-SAFE: safe mode is ON by default whenever EMAIL_SAFE_MODE is unset.
# To send real email in production you MUST explicitly set EMAIL_SAFE_MODE=false.
EMAIL_SAFE_MODE=true

# Comma-separated list of addresses allowed to receive mail while safe mode is on.
# Seed this with your own team's test inboxes.
EMAIL_ALLOWLIST=henrydavidphotography@gmail.com

# -----------------
# Cloudflare R2 (Required for the music library and book builder)
# -----------------
# The private bucket holding part PDFs. Without these the library, the
# questionnaire match screen, and book building are all unavailable.
# Get from: Cloudflare dashboard > R2 > Manage API Tokens
# SECRET: Server-side only
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=podium-repertoire

# The bucket MUST stay private — no Public Development URL, no custom public
# domain. Every read is a short-lived presigned link minted per click by
# /api/library/parts/[partId]. A public bucket would expose the whole catalogue.

# -----------------
# Stripe (Required for billing)
# -----------------
# Get from: https://dashboard.stripe.com/apikeys
# SECRET: Server-side only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# One Stripe Price ID per paid tier. These names must match exactly — plan.ts
# maps a subscription's price id back to its tier through them, so a missing or
# misnamed var makes priceIdToTier() return null and every webhook lands with
# no tier attached.
# Get from: https://dashboard.stripe.com/products
STRIPE_ENSEMBLE_PRICE_ID=price_your_ensemble_price_id
STRIPE_ORCHESTRA_PRICE_ID=price_your_orchestra_price_id
STRIPE_SYMPHONY_PRICE_ID=price_your_symphony_price_id

# --- BILLING MASTER SWITCH ---
# While this is unset or false, EVERY org resolves to Symphony regardless of
# subscription — the pre-launch state. Set to true to turn on real plan
# resolution and feature gating.
#
# Flip this TOGETHER with the database switch, or the two disagree:
#   1. here:     NEXT_PUBLIC_BILLING_ENABLED=true
#   2. Postgres: UPDATE app_settings SET billing_enforced = true;
# App only → the UI gates but the database still accepts over-limit writes.
# DB only  → inserts fail with no upgrade prompt explaining why.
#
# Comped orgs (organizations.is_comped) keep full Symphony access either way —
# that is what founding members are on, so enabling billing never touches them.
NEXT_PUBLIC_BILLING_ENABLED=false

# -----------------
# Cron Jobs (Required for scheduled tasks)
# -----------------
# A secret string to authenticate Vercel cron job requests
# Generate a strong random string for production
CRON_SECRET=your_cron_secret

# Defense-in-depth switch for scheduled jobs. Defaults ENABLED when unset.
# Set CRON_ENABLED=false in a testing/preview environment to make all cron
# jobs no-op (they log and skip) so they don't auto-send or mutate state.
CRON_ENABLED=true

# -----------------
# Spotify (Optional)
# -----------------
# Powers popularity ranking when suggesting repertoire from a client's playlist.
# The feature degrades quietly when unset.
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# -----------------
# Platform Admin (Optional)
# -----------------
# Gets a copy of the welcome email when a new organization signs up — your
# heads-up that someone new has landed. No notification is sent when unset.
PLATFORM_ADMIN_EMAIL=you@yourdomain.com
